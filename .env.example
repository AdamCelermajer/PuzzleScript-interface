# ARC_PROXY_PORT=8000
# WORKBENCH_API_PORT=8010
# WORKBENCH_WEB_PORT=5173
# Global default for all built-in and submitted PuzzleScript games.
# PUZZLESCRIPT_GRID_ENCODING=visible-cell-v1
