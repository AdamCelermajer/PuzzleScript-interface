# Optional: OpenRouter models in Codex AVO, and the historical rule-learning client
OPENROUTER_API_KEY=
# Optional: NanoGPT models in the workbench, direct player, and AVO
NANOGPT_API_KEY=
# Optional: official ARC backend only
ARC_API_KEY=
# Unprefixed Codex models use the existing OAuth login.
# Use openrouter/vendor/model or nanogpt/model to select an API provider.
