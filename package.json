{
  "name": "puzzlescript-server-client",
  "version": "1.0.0",
  "description": "Server-client architecture for running PuzzleScript games",
  "main": "puzzlescript_interface/runtime/server.js",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-owned-processes.ps1",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1 up",
    "benchmark:server": "uv run python -m benchmark.server",
    "benchmark:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-owned-processes.ps1 -WithBenchmark",
    "benchmark:artifacts": "node scripts/build_benchmark_artifacts.js",
    "dev": "nodemon puzzlescript_interface/runtime/server.js",
    "test": "node --test tests/puzzlescript_interface/*.test.js && uv run python -m unittest discover -s tests/puzzlescript_interface -p \"test_*.py\" && uv run python -m unittest discover -s tests/workbench -p \"test_*.py\" && uv run python -m unittest discover -s tests/benchmark -p \"test_*.py\"",
    "website:dev": "npm --prefix website/app run dev",
    "website:build": "npm --prefix website/app run build",
    "website:preview": "npm --prefix website/app run preview",
    "workbench": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-workbench.ps1"
  },
  "keywords": [
    "puzzlescript",
    "game-engine",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "puzzlescript": "^6.0.0-alpha.2"
  },
  "devDependencies": {
    "dompurify": "^3.4.14",
    "katex": "^0.18.4",
    "marked": "^18.0.10",
    "nodemon": "^3.0.0",
    "pdfjs-dist": "^6.2.108",
    "vite": "^6.0.0"
  }
}
